# Generated artefacts. Everything here is reproducible from a config and a seed.
# Anchored to the repository root, so that the `data` package and its tests are not
# swept up by a rule meant for the generated data store.
/data/
/runs/
/checkpoints/
/plots/
/reports/
*.h5
*.hdf5
*.pt
*.ckpt

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
